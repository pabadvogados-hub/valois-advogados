# =============================================================================
#  systemd unit - Agente VALOIS.IA (FastAPI / uvicorn na porta 8787)
#  Instalar em: /etc/systemd/system/valois-agente.service
#  Ajuste User= e os caminhos (WorkingDirectory/ExecStart) para o seu ambiente.
# =============================================================================
[Unit]
Description=Agente Operacional VALOIS.IA (webhook FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/valois-advogados
# .env e lido pelo proprio codigo (config/.env via python-dotenv); nao precisa EnvironmentFile.
ExecStart=/home/deploy/valois-advogados/.venv/bin/python -m uvicorn OPERACIONAL.agente_operacional.webhook:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=5
# Logs vao pro journald (ver com: journalctl -u valois-agente -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
